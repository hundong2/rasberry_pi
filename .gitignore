# macOS와 IDE가 만드는 프로젝트 외 파일
.DS_Store
.idea/
.vscode/

# Codex와 SSH 연결 과정에서 만들어지는 런타임 소켓
*.sock

# C/C++ 빌드 산출물
**/build/
**/out/
**/*.o
**/*.obj
**/*.d
**/*.a
**/*.so
**/*.dylib
**/*.exe

# Node.js/TypeScript 의존성과 빌드·테스트 산출물
**/node_modules/
**/dist/
**/coverage/
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python 캐시와 가상 환경
**/__pycache__/
**/*.py[cod]
**/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 로컬 환경 변수와 비밀값 (배포 예제 파일은 추적)
.env
.env.*
!.env.example
!**/.env.example

# 학습 과정에서 생성되는 대용량 결과물과 모델 바이너리
runs/
checkpoints/
**/*.pt
**/*.pth
**/*.onnx
**/*.engine
**/*.tflite
