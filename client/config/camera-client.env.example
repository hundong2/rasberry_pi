# NestJS 서버 주소다. 비밀값은 아니며 실제 Mac/서버 IP와 port로 변경한다.
CAMERA_SERVER_URL=http://192.168.45.89:3000

# 서버 CAMERA_TOKEN과 정확히 같은 값이다. chmod 0600 설정 파일로 보호한다.
# 실제 값은 Git에 커밋하지 않는다.
CAMERA_TOKEN=

# 장치별로 변하지 않는 고유 ID를 사용한다. 영문자, 숫자, _, -만 허용된다.
CAMERA_ID=raspberry-pi-1
# rpicam-vid가 캡처할 JPEG 너비와 높이다.
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# 초당 캡처 장수이며 서버 처리 상한보다 높으면 frame drop이 늘 수 있다.
CAMERA_FPS=10
# 30~95 범위 JPEG 품질이다. 높을수록 화질과 네트워크 사용량이 함께 증가한다.
JPEG_QUALITY=80
