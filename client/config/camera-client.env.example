# The server URL is not a secret. Change it to the host running the NestJS server.
CAMERA_SERVER_URL=http://192.168.45.89:3000

# Set this through a protected deployment secret or a chmod 0600 environment file.
CAMERA_TOKEN=

# Each deployed device needs a stable, unique identifier.
CAMERA_ID=raspberry-pi-1
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=10
JPEG_QUALITY=80
