[Unit]
Description=Raspberry Pi C++ camera streaming client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video
EnvironmentFile=/etc/camera-client.env
ExecStart=/opt/camera-client/bin/camera-client
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
