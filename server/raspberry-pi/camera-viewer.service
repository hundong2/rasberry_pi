[Unit]
Description=Raspberry Pi camera viewer sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/camera-viewer
EnvironmentFile=/etc/camera-viewer.env
ExecStart=/opt/camera-viewer/.venv/bin/python sender.py --server ${SERVER_URL} --token ${CAMERA_TOKEN} --camera-id ${CAMERA_ID}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
