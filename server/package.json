{
  "name": "camera-real-time-viewer-server",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time Raspberry Pi camera ingestion, OpenCV processing, and web viewing server",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
